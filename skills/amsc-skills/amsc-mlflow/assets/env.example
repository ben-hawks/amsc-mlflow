# AmSC MLflow settings for the amsc-mlflow skill. Copy to .env (git-ignored) or export these.
# Never put the token itself in a file that is committed or readable by others.

MLFLOW_TRACKING_URI="https://mlflow-staging.american-science-cloud.org"
# Development server used by the AmSC intro-to-mlflow-pytorch examples:
# MLFLOW_TRACKING_URI="https://mlflow.ms.dev.american-science-cloud.org"

# Team workspace (needs the workspace user role); "none" = the server's default workspace.
MLFLOW_WORKSPACE="modelservices"

# Personal experiments should include your username.
# MLFLOW_EXPERIMENT_NAME="<project>-<username>"

# The MyAmSC Access Token (Profile -> Raw Tokens -> Access Token; not the ID Token).
# Interactive shells: `read -s MLFLOW_TRACKING_TOKEN; export MLFLOW_TRACKING_TOKEN`.
# Batch jobs: a chmod-600 file read by amsc_mlflow / mlflow_job_env.sh:
# MLFLOW_TRACKING_TOKEN_FILE="$HOME/.amsc/mlflow_token"

# Proxy multipart uploads for large artifacts (amsc_mlflow sets these by default;
# AMSC_MLFLOW_MULTIPART=0 turns that off).
# MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD="true"
# MLFLOW_MULTIPART_UPLOAD_MINIMUM_FILE_SIZE="5242880"
# MLFLOW_MULTIPART_UPLOAD_CHUNK_SIZE="104857600"

# Only if a platform admin says the environment requires it:
# MLFLOW_TRACKING_INSECURE_TLS="true"
